# Copy to .env.local (git-ignored) and fill in from the Firebase console. Never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check debug token (debug builds only, never ship). "true" makes the SDK generate one and
# print it in the offscreen document's DevTools console; register it in the Firebase console.
# Or paste an already-registered token string.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional override of the cloud model used for in-cloud inference.
VITE_AI_CLOUD_MODEL=
